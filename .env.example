# ============================================================
# 海创Buddy 环境变量模板
# 复制为 .env.local 后填入真实值；.env.local 已在 .gitignore 中，禁止提交
# ============================================================

# ---------- 数据来源 ----------
# mock  = 使用内置演示数据（默认，无需任何凭证，重启还原）
# local = 本地 PGlite 持久化（默认目录 .data/pgdata，启动时自动迁移）
#         商品图片单独存放于 .data/product-images，数据库只保存短地址
# db    = 使用 Supabase PostgreSQL（需先填 DATABASE_URL 并执行 pnpm db:migrate）
# 注意：设为 db 但没配 DATABASE_URL 会直接报错，不会静默回退到 mock
DATA_SOURCE=mock
# local 模式可指定持久化目录；同一目录只允许一个应用实例使用
# LOCAL_DB_DIR=.data/pgdata

# ---------- 数据层：Supabase PostgreSQL ----------
# Drizzle ORM 在服务端使用的连接串
# Supabase 控制台 → Project Settings → Database → Connection string
#   连接池（推荐填这个）：...pooler.supabase.com:6543/postgres
#   直连（用于迁移）：...supabase.co:5432/postgres 或 pooler 的 5432
DATABASE_URL=
# 浏览器端 SDK 使用（仅这两个是公开值，可出现在前端代码中）
# 目前浏览器端不直连 Supabase，图片直读走公共 URL，先留空即可
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，严禁出现在客户端代码或日志中
# 控制台 → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 对象存储：Supabase Storage ----------
# 仅 DATA_SOURCE=db 使用；local 模式无需 Supabase 即可上传图片。
# 商品图片存储复用上面两个变量，无需额外配置：
#   配置判定规则：NEXT_PUBLIC_SUPABASE_URL 与 SUPABASE_SERVICE_ROLE_KEY 缺一即视为
#   未开启图片上传（表单会隐藏选图入口，其余功能不受影响）。
#   bucket 名固定为 product-images（定义在 src/storage/paths.ts，首次上传自动创建为 public）。
#   对象路径规则：products/{yyyy}/{MM}/{name-slug}-{suffix}.{ext}

# ---------- 模型层：阿里云百炼 DashScope（OpenAI 兼容协议）----------
# AI_PROVIDER 取值：mock / dashscope / openai / deepseek / custom
#   mock       —— 本地确定性实现，不联网、零凭证（默认；留空即等同 mock）
#                 产出会在 riskNotes 首位带「【Mock】占位数据」标记，不会被当成真实结论
#   dashscope  —— 通义千问，已实现。填好 DASHSCOPE_API_KEY 即可生效
#   openai / deepseek / custom —— 尚未接入，配置后会明确报 NOT_IMPLEMENTED，
#                 而不是偷偷用 mock 顶替（避免「以为在调真模型」）
# 换成真实模型只改这里，Agent / Service / 页面代码一行都不用动。
AI_PROVIDER=mock

# —— DashScope 专用 ——
# 阿里云百炼控制台 → API-KEY 管理。取值优先级：DASHSCOPE_API_KEY → AI_API_KEY
DASHSCOPE_API_KEY=
# 可选：私有网关 / 代理时覆盖；留空则用官方兼容模式地址
# 默认 https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# 单次模型调用超时（毫秒）。视觉模型较慢，默认 90000
AI_TIMEOUT_MS=90000

# —— 通用模型配置（DASHSCOPE_* 缺省时的回退来源）——
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 常规文本生成与任务拆解（Provider 的 "fast" 档）
AI_MODEL_FAST=qwen-plus
# 复杂推理（Business Brain 任务规划、Product Agent 结构化输出，即 "reasoning" 档）
AI_MODEL_REASONING=qwen-max
# 图像理解（Product Agent 商品图片分析，即 "vision" 档）
AI_MODEL_VISION=qwen-vl-max
# 文本向量化（RAG 客服知识库检索，即 "embedding" 档）
AI_MODEL_EMBEDDING=text-embedding-v3

# ---------- 可选：通义万相创意背景（营销海报） ----------
# 默认复用 DASHSCOPE_API_KEY / AI_API_KEY 和文本接口所在的地域。
# 单独设置时，根地址与密钥必须来自同一地域和业务空间。
# 示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
# WANXIANG_API_KEY=
# WANXIANG_BASE_URL=
# 支持 wan2.6-t2i / wan2.5-t2i-preview / wan2.2-t2i-flash
WANXIANG_MODEL=wan2.6-t2i
# 只有点击“生成 AI 创意背景”才提交一张图像请求；Mock 模式不联网。
# 生成结果保存在 .data/poster-backgrounds；部署需配置可写持久存储。

# 管理员邮箱白名单；多个邮箱以逗号分隔，仍需使用已注册账号登录
ADMIN_EMAILS=
