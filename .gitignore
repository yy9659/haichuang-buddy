# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 本地数据库数据目录（PGlite 的 PostgreSQL 数据文件，属运行时状态，不入库）
/.data

# 本地依赖缓存、工具记忆与发布备份
/.pnpm-store/
/.workbuddy/

# 本地编辑器与浏览器自动化产物
/playwright-report/
/test-results/
/.vscode/

# 保留已随项目发布的背景视频，其余录屏放在本地素材目录
/recordings/
/video-output/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
